{
  "name": "drakox",
  "version": "0.1.0",
  "description": "DrakoX — the free, open-source, model-agnostic AI coding agent harness. Terminal agent + agent-first web IDE + universal integrations (MCP).",
  "license": "MIT",
  "type": "module",
  "author": "DrakoX contributors",
  "homepage": "https://github.com/Dimova88/DrakoX",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dimova88/DrakoX.git"
  },
  "keywords": [
    "ai",
    "agent",
    "coding-agent",
    "cli",
    "ide",
    "mcp",
    "ollama",
    "llm",
    "claude-code-alternative",
    "codex-alternative",
    "cursor-alternative"
  ],
  "bin": {
    "drakox": "dist/cli/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "agents",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "npm run build:core && npm run build:web",
    "build:core": "tsc -p tsconfig.json && node scripts/postbuild.mjs",
    "build:web": "vite build --config web/vite.config.ts",
    "dev": "tsx src/cli/index.ts",
    "dev:ui": "tsx src/cli/index.ts ui --no-open",
    "dev:web": "vite --config web/vite.config.ts",
    "start": "node dist/cli/index.js",
    "demo": "node scripts/demo.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "diff": "^9.0.0",
    "ignore": "^7.0.5",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.9.1",
    "tinyglobby": "^0.2.15",
    "turndown": "^7.2.4",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.2",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "highlight.js": "^11.12.0",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.57.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "zustand": "^5.0.15"
  }
}
